#!/usr/bin/env bash

RED='\033[1;31m'
GREEN='\033[1;32m'
YELLOW='\033[1;33m'
CYAN='\033[1;36m'
NC='\033[0m'

commit_file="$1"
message=$(head -n1 "$commit_file")

regex='^(build|ci|docs|feat|fix|perf|refactor|style|test)(\([a-zA-Z0-9_-]+\))?: .+'

if ! echo "$message" | grep -Eq "$regex"; then
    echo
    echo -e "${RED}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${NC}"
    echo -e "${RED}❌ Format commit message tidak sesuai${NC}"
    echo -e "${RED}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${NC}"
    echo

    echo -e "${YELLOW}Format yang diharapkan:${NC}"
    echo -e "  ${GREEN}<type>: <description>${NC}"
    echo -e "  ${GREEN}<type>(scope): <description>${NC}"
    echo

    echo -e "${CYAN}Contoh:${NC}"
    echo -e "  feat: menambahkan halaman login"
    echo -e "  fix(api): mengatasi null response"
    echo -e "  docs: update README"
    echo

    echo -e "${CYAN}Tipe commit yang diperbolehkan:${NC}"
    echo -e "  ${GREEN}build${NC}     Perubahan pada build system atau dependency"
    echo -e "  ${GREEN}ci${NC}        Perubahan konfigurasi CI/CD"
    echo -e "  ${GREEN}docs${NC}      Perubahan dokumentasi"
    echo -e "  ${GREEN}feat${NC}      Penambahan fitur baru"
    echo -e "  ${GREEN}fix${NC}       Perbaikan bug"
    echo -e "  ${GREEN}perf${NC}      Peningkatan performa"
    echo -e "  ${GREEN}refactor${NC}  Perubahan kode tanpa menambah fitur/memperbaiki bug"
    echo -e "  ${GREEN}style${NC}     Perubahan formatting/style kode"
    echo -e "  ${GREEN}test${NC}      Penambahan atau perbaikan test"
    echo

    echo -e "${CYAN}Lihat ${YELLOW}SOP Git Management${NC} ${CYAN}untuk info lebih detail.${NC}"
    echo

    exit 1
fi

exit 0